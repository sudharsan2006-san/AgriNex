# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# WEATHER_API_KEY: Required for fetching live weather data.
WEATHER_API_KEY="MY_WEATHER_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Required for the Live Weather Map. Must have VITE_ prefix to be accessible in client-side code.
VITE_GOOGLE_MAPS_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EMAILJS_SERVICE_ID: Required for sending booking status emails via EmailJS.
VITE_EMAILJS_SERVICE_ID=""
# EMAILJS_TEMPLATE_ID: Required for sending booking status emails via EmailJS.
VITE_EMAILJS_TEMPLATE_ID=""
# EMAILJS_PUBLIC_KEY: Required for sending booking status emails via EmailJS.
VITE_EMAILJS_PUBLIC_KEY=""

# RESEND_API_KEY: Preferred backend provider for confirmation email sending.
RESEND_API_KEY=""
# RESEND_FROM_EMAIL: Verified Resend sender, e.g. "AgriNex <noreply@example.com>".
RESEND_FROM_EMAIL=""
# EMAIL_USER and EMAIL_PASS: SMTP fallback for backend confirmation email sending.
EMAIL_USER=""
EMAIL_PASS=""
